# Production Core Backend API Base URL (with version prefix)
# e.g. https://api.unimate.yourcampus.edu/api/v1 or https://unimate-api.onrender.com/api/v1
VITE_API_URL=https://api-unimate.example.com/api/v1

# Institutional campus branding
VITE_CAMPUS_NAME="UniMate Smart Campus"
