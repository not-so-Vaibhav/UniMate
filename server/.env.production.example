# =================================================================
# UniMate Core Backend - Production Environment Configuration
# =================================================================
# IMPORTANT: In production, generate a secure random 64-character JWT secret:
# openssl rand -hex 32
# =================================================================

NODE_ENV=production
PORT=5001

# Public URL of the frontend application (for CORS allowlist)
# e.g. https://unimate.yourcampus.edu or https://unimate.vercel.app
CLIENT_URL=https://unimate-campus.example.com

# Managed MySQL Database Credentials (e.g. Aiven, Railway, AWS RDS, DigitalOcean)
DB_HOST=mysql.your-cloud-provider.com
DB_PORT=3306
DB_USER=unimate_prod_user
DB_PASSWORD=REPLACE_WITH_STRONG_GENERATED_PASSWORD
DB_NAME=unimate_db

# Cryptographic Token Secret (Minimum 32 characters, 64 recommended)
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_64_CHAR_HEX_KEY
JWT_EXPIRES_IN=24h

# Internal or Private VPC URL of the Python FastAPI AI Subsystem
AI_SERVICE_URL=http://ai-service:8000

# File Upload Limits
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,docx,jpg,png
