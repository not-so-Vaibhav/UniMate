# ==========================================
# UniMate Environment Configuration Baseline
# ==========================================

# Core Backend Configuration (server)
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=unimate_db

# Authentication / Security
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=24h

# AI Service Configuration (FastAPI)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000

# File Upload Configuration
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,docx,jpg,png

# Frontend Configuration (client)
VITE_API_BASE_URL=http://localhost:5001/api/v1
