# =================================================================
# UniMate AI Subsystem (FastAPI) - Production Configuration
# =================================================================

HOST=0.0.0.0
PORT=8000
AI_SERVICE_PORT=8000

# AI Generation Mode:
# - HYBRID: Uses Gemini grounded generation with verified corpus; falls back to deterministic extraction if unavailable
# - DETERMINISTIC_ONLY: Strictly uses local deterministic keyword retrieval
# - GEMINI_ONLY: Requires valid Gemini API key
AI_MODE=HYBRID

# Google Gemini API Key (Required for natural language grounded generation)
# Get a production or student developer key at https://aistudio.google.com
GEMINI_API_KEY=REPLACE_WITH_VALID_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# Minimum similarity confidence threshold (0.0 to 1.0)
CONFIDENCE_THRESHOLD=0.28
GEMINI_TIMEOUT_SECONDS=8.0
